{
  "openapi": "3.1.0",
  "info": {
    "title": "Chess Backend API",
    "description": "REST API for the chess-backend-java project. WebSocket/STOMP is documented in README.md and is not covered by this spec.",
    "version": "0.0.1-SNAPSHOT"
  },
  "servers": [
    {
      "url": "https://chess-backend.duckdns.org",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "Players",
      "description": "Player history endpoints."
    },
    {
      "name": "Authentication",
      "description": "Authenticated-user endpoints."
    },
    {
      "name": "Authentication",
      "description": "Authenticated-user information."
    },
    {
      "name": "Rooms",
      "description": "Create, join, and read chess rooms."
    },
    {
      "name": "Games",
      "description": "Make moves and read game state."
    },
    {
      "name": "Health",
      "description": "Application status endpoint."
    }
  ],
  "paths": {
    "/api/rooms": {
      "post": {
        "tags": [
          "Rooms"
        ],
        "summary": "Create a room",
        "description": "Creates a new room with the caller as its single player. The caller's side comes from the optional preferredSide field (WHITE/BLACK/RANDOM; omitted defaults to WHITE; RANDOM is coin-flipped server-side). The response role reflects the resolved side, alongside the assigned playerId and the freshly generated roomId. The response also carries a secret joinToken (only the creator obtains it) that the opponent must supply to POST /api/rooms/{id}/join.",
        "operationId": "createRoom",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRoomRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Room created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoomResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request (validation failure or malformed JSON)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/rooms/{id}/join": {
      "post": {
        "tags": [
          "Rooms"
        ],
        "summary": "Join a room",
        "description": "Joins {id} as the second player and creates the game in the same atomic step. Requires the secret joinToken the creator obtained from the create response; a missing or wrong token returns 403 INVALID_JOIN_TOKEN (the roomId alone, used for watching, does not authorise joining). The joiner's role is the opposite of the side the creator chose at create time. Path {id} is case-insensitive; the canonical uppercase form is returned in the body.",
        "operationId": "joinRoom",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JoinRoomRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Joined; game created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoomResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request (validation failure or malformed JSON)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Missing or invalid join token for a token-protected room",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Room does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Room already has two players",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/games/{id}/moves": {
      "post": {
        "tags": [
          "Games"
        ],
        "summary": "Apply a move",
        "description": "Applies a move on behalf of the caller (identified by the X-Player-Id header). The move is rejected if it is not the caller's turn, if the move is illegal in the current position, or if the game has already ended.",
        "operationId": "move",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Player-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MoveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Move applied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameStateResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request (validation failure on body fields, malformed JSON body, malformed UUID in path or header, or missing X-Player-Id header)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Game does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Game has already ended",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Move is illegal or not the caller's turn",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Register a new account",
        "description": "Creates a user with the given email + password (BCrypt-hashed) + display name and returns a freshly issued JWT. The token is immediately usable as the Authorization: Bearer header on subsequent authenticated requests — there is no separate confirmation step.",
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Account created; response carries the JWT and the user profile.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed (malformed email, missing field, password outside 8-72 chars, etc.).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "An account with this email already exists.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Log in with email and password",
        "description": "Validates the credentials and returns a freshly issued JWT. The failure response is uniform — wrong password and unknown email both surface as 401 INVALID_CREDENTIALS with the same generic message, to avoid leaking which accounts exist.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Authenticated; response carries the JWT and the user profile.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed (malformed email, missing field).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid email or password.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/rooms/{id}": {
      "get": {
        "tags": [
          "Rooms"
        ],
        "summary": "Get room state by id",
        "description": "Reads the current state of a room: the players (with roles derived from the creator's chosen side), the associated gameId if the room is ACTIVE, and the lifecycle status. The frontend uses this either as the primary discovery mechanism for Player A (poll until gameId is non-null) or as a fallback to STOMP /topic/rooms/{roomId} for late subscribers, which cannot replay events. Path {id} is case-insensitive; the canonical uppercase form is returned in the body.",
        "operationId": "getRoom",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Room exists; returns its current state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoomDetailsResponse"
                }
              }
            }
          },
          "404": {
            "description": "Room does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/players/{id}/games": {
      "get": {
        "tags": [
          "Players"
        ],
        "summary": "List a player's game history",
        "description": "Returns archived (terminal-status) games for the given player, newest first, capped at 50 entries. An unknown player id returns 200 with an empty array — guests have no registry, so 404 is not used.",
        "operationId": "getPlayerGames",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Player game history (possibly empty).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PlayerGameSummary"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request (malformed UUID in path).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Get the authenticated user",
        "description": "Returns the user identified by the Authorization: Bearer JWT. Requires a valid token issued by this backend; the response includes the user's id, canonical email, and display name. JWT issuance ships in feature 17; this endpoint is the validator side of the contract.",
        "operationId": "me",
        "responses": {
          "200": {
            "description": "Authenticated user details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, expired, or unsigned-by-us JWT. Feature 17's AuthEntryPoint writes a structured ErrorResponse body with code AUTHENTICATION_REQUIRED — the same envelope every other 4xx in the API uses.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/me/games": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "List the authenticated user's archived games",
        "description": "Returns the archived (terminal-status) games where the caller participated as either side, newest first, in the standard Spring Data Page envelope. Pagination params: page (default 0, min 0); size (default 20, min 1, max 100). Requires a valid Bearer JWT — anonymous requests get 401 AUTHENTICATION_REQUIRED. The page shape is the standard Spring Data envelope: { content, totalElements, totalPages, size, number, ... }.",
        "operationId": "getMyGames",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0,
              "minimum": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20,
              "maximum": 100,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of archived games (possibly empty).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MyGamesPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid pagination parameter (page < 0 or size outside [1, 100]).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, expired, or unsigned-by-us JWT. Body is the standard ErrorResponse envelope with code AUTHENTICATION_REQUIRED.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Application health",
        "description": "Returns the application status, build version, and current server time.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Service is up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/games/{id}": {
      "get": {
        "tags": [
          "Games"
        ],
        "summary": "Read game state",
        "description": "Returns the current state of the game: position FEN, status, whose turn it is, the two players, and the full move history.",
        "operationId": "get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current game state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameStateResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request (malformed UUID in path)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Game does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateRoomRequest": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "example": "Alice",
            "minLength": 1
          },
          "preferredSide": {
            "type": "string",
            "description": "The creator's requested side. WHITE or BLACK pin the creator's colour; RANDOM lets the server coin-flip it (the client cannot bias the result). Optional: omitting the field defaults to WHITE.",
            "enum": [
              "WHITE",
              "BLACK",
              "RANDOM"
            ],
            "example": "WHITE"
          },
          "timeControl": {
            "$ref": "#/components/schemas/TimeControl",
            "description": "Optional time control. When present, both sides start at initialMs and the server tracks the clock authoritatively, auto-flagging (status TIMEOUT) when the side to move runs out. Omit the field for an untimed game."
          },
          "opponentKind": {
            "type": "string",
            "description": "The opponent kind. FRIEND (the default when omitted) creates a room another human joins; BOT creates a complete game against the Stockfish engine immediately, so the response carries a non-null gameId and no joinToken.",
            "enum": [
              "FRIEND",
              "BOT"
            ],
            "example": "FRIEND"
          },
          "botElo": {
            "type": "integer",
            "format": "int32",
            "description": "Requested bot target strength as an Elo, relevant only when opponentKind=BOT. The server maps it to the engine's skill level (Fairy-Stockfish) rather than exposing a raw engine parameter. Must lie within 400-3190 (the ~400 floor stays reachable for true beginners). Omit the field to use the server's configured default strength.",
            "example": 1500,
            "maximum": 3190,
            "minimum": 400
          }
        }
      },
      "TimeControl": {
        "type": "object",
        "properties": {
          "initialMs": {
            "type": "integer",
            "format": "int64",
            "description": "Starting clock per side, in milliseconds. Strictly positive.",
            "example": 300000
          },
          "incrementMs": {
            "type": "integer",
            "format": "int64",
            "description": "Fischer increment added back to a player's clock after they move, in milliseconds. Zero for plain sudden-death.",
            "example": 3000
          }
        }
      },
      "RoomResponse": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string",
            "description": "6-char short code from the alphabet ABCDEFGHJKMNPQRSTUVWXYZ23456789. Case-insensitive in URLs; canonical uppercase form returned here.",
            "example": "K7M3X9"
          },
          "playerId": {
            "type": "string",
            "format": "uuid",
            "description": "Server-generated UUID identifying the caller as a player in the room.",
            "example": "8b3c1f04-1234-5678-9abc-def012345678"
          },
          "role": {
            "type": "string",
            "description": "Side assigned to the caller. On create it is the creator's chosen side (WHITE by default, or BLACK / a RANDOM coin-flip result if requested); on join it is the opposite of the creator's side.",
            "example": "WHITE"
          },
          "gameId": {
            "type": "string",
            "format": "uuid",
            "description": "UUID of the chess game associated with the room. Null on the create response (no game exists yet); non-null on the join response.",
            "example": "0d52a8a0-aaaa-bbbb-cccc-ddddeeee0000"
          },
          "joinToken": {
            "type": "string",
            "description": "Secret join token required by POST /api/rooms/{id}/join. Non-null ONLY on the create response — the creator keeps it and shares it out-of-band with the opponent. Null on the join response, and never returned by GET /api/rooms/{id}. Possession of the roomId alone (used for watching) does not authorise joining.",
            "example": "8b3c1f04-1234-5678-9abc-def012345678"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Standard error envelope returned by every 4xx response from the API.",
        "properties": {
          "error": {
            "type": "string",
            "description": "Stable upper-snake-case error code identifying the error class. Intended for programmatic matching by clients.",
            "enum": [
              "ROOM_NOT_FOUND",
              "ROOM_FULL",
              "GAME_NOT_FOUND",
              "GAME_ALREADY_ENDED",
              "ILLEGAL_MOVE",
              "NOT_YOUR_TURN",
              "VALIDATION_FAILED",
              "MALFORMED_REQUEST",
              "MISSING_HEADER",
              "AUTHENTICATION_REQUIRED",
              "EMAIL_ALREADY_TAKEN",
              "INVALID_CREDENTIALS",
              "INVALID_JOIN_TOKEN"
            ],
            "example": "ROOM_NOT_FOUND"
          },
          "message": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "JoinRoomRequest": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "example": "Bob",
            "minLength": 1
          },
          "joinToken": {
            "type": "string",
            "description": "Secret join token obtained by the creator from the create response and shared out-of-band with the opponent. Required for rooms created after feature 22.7 shipped; a missing or wrong token returns 403 INVALID_JOIN_TOKEN.",
            "example": "8b3c1f04-1234-5678-9abc-def012345678"
          }
        }
      },
      "MoveRequest": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "description": "Origin square in algebraic notation, lowercase.",
            "example": "e2",
            "minLength": 1,
            "pattern": "^[a-h][1-8]$"
          },
          "to": {
            "type": "string",
            "description": "Destination square in algebraic notation, lowercase.",
            "example": "e4",
            "minLength": 1,
            "pattern": "^[a-h][1-8]$"
          },
          "promotion": {
            "type": "string",
            "description": "Promotion piece for pawn promotion; one of KNIGHT, BISHOP, ROOK, QUEEN. Null otherwise.",
            "example": "QUEEN",
            "pattern": "^(KNIGHT|BISHOP|ROOK|QUEEN)$"
          }
        }
      },
      "GameStateResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "roomId": {
            "type": "string"
          },
          "white": {
            "$ref": "#/components/schemas/PlayerView"
          },
          "black": {
            "$ref": "#/components/schemas/PlayerView"
          },
          "fen": {
            "type": "string",
            "description": "Current position in Forsyth-Edwards Notation.",
            "example": "rnbqkbnr/pppppppp/8/8/4P3/8/PPPP1PPP/RNBQKBNR b KQkq - 0 1"
          },
          "status": {
            "type": "string",
            "enum": [
              "ONGOING",
              "CHECK",
              "CHECKMATE",
              "STALEMATE",
              "DRAW",
              "ABANDONED",
              "TIMEOUT"
            ]
          },
          "turn": {
            "type": "string",
            "description": "Side whose turn it is. WHITE if move count is even, BLACK if odd.",
            "enum": [
              "WHITE",
              "BLACK"
            ],
            "example": "WHITE"
          },
          "moves": {
            "type": "array",
            "description": "Full move history in playback order.",
            "items": {
              "$ref": "#/components/schemas/MoveSummary"
            }
          },
          "whiteTimeRemainingMs": {
            "type": "integer",
            "format": "int64",
            "description": "White's remaining clock in milliseconds, frozen at the last move. Null for an untimed game. The live value of the side to move is remaining - (now - lastMoveAt).",
            "example": 298500
          },
          "blackTimeRemainingMs": {
            "type": "integer",
            "format": "int64",
            "description": "Black's remaining clock in milliseconds, frozen at the last move. Null for an untimed game.",
            "example": 300000
          },
          "lastMoveAt": {
            "type": "string",
            "format": "date-time",
            "description": "Instant the side-to-move's clock started counting, ISO-8601 UTC. Null for an untimed game.",
            "example": "2026-05-29T10:23:11.123Z"
          }
        }
      },
      "MoveSummary": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "description": "Origin square in algebraic notation, lowercase.",
            "example": "e2"
          },
          "to": {
            "type": "string",
            "description": "Destination square in algebraic notation, lowercase.",
            "example": "e4"
          },
          "promotion": {
            "type": "string",
            "description": "Promotion piece for pawn promotion; one of KNIGHT, BISHOP, ROOK, QUEEN. Null otherwise.",
            "example": "QUEEN"
          }
        }
      },
      "PlayerView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Player id.",
            "example": "8b3c1f04-1234-5678-9abc-def012345678"
          },
          "displayName": {
            "type": "string",
            "description": "Display name provided at game start.",
            "example": "Alice"
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Account email; case-insensitive, normalised to lowercase server-side.",
            "maxLength": 254,
            "minLength": 0
          },
          "password": {
            "type": "string",
            "description": "Plain-text password; 8-72 chars (72 is BCrypt's input cap — longer passwords would be silently truncated by the hash function).",
            "maxLength": 72,
            "minLength": 8
          },
          "displayName": {
            "type": "string",
            "description": "Human-readable name shown in the UI.",
            "maxLength": 100,
            "minLength": 0
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "JWT to send on subsequent authenticated requests as Authorization: Bearer ..."
          },
          "user": {
            "$ref": "#/components/schemas/MeResponse"
          }
        }
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Authenticated user's UUID; equal to the JWT 'sub' claim."
          },
          "email": {
            "type": "string",
            "description": "Canonical lowercase email associated with the account."
          },
          "displayName": {
            "type": "string",
            "description": "Human-readable name shown in the UI."
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Account email; case-insensitive, normalised to lowercase server-side.",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "description": "Plain-text password.",
            "minLength": 1
          }
        }
      },
      "PlayerInRoom": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Server-generated UUID identifying the player.",
            "example": "8b3c1f04-1234-5678-9abc-def012345678"
          },
          "displayName": {
            "type": "string",
            "description": "Human-readable label provided at join time.",
            "example": "Alice"
          },
          "role": {
            "type": "string",
            "description": "Side assigned to the player. WHITE for the creator (players[0]), BLACK for the joiner (players[1]).",
            "enum": [
              "WHITE",
              "BLACK"
            ],
            "example": "WHITE"
          }
        }
      },
      "RoomDetailsResponse": {
        "type": "object",
        "description": "Current state of a room: members, derived roles, game association, status.",
        "properties": {
          "roomId": {
            "type": "string",
            "description": "6-char short code from the alphabet ABCDEFGHJKMNPQRSTUVWXYZ23456789. Case-insensitive in URLs; canonical uppercase form returned here.",
            "example": "K7M3X9"
          },
          "players": {
            "type": "array",
            "description": "Players in the room. Index 0 is the creator and holds the side they chose at create time; index 1 (when present) is the joiner and holds the opposite side. The array has 1 element while WAITING_FOR_PLAYER and 2 while ACTIVE.",
            "items": {
              "$ref": "#/components/schemas/PlayerInRoom"
            }
          },
          "gameId": {
            "type": "string",
            "format": "uuid",
            "description": "UUID of the chess game associated with the room. Null while the room is WAITING_FOR_PLAYER (no game has been created yet); non-null once ACTIVE.",
            "example": "0d52a8a0-aaaa-bbbb-cccc-ddddeeee0000"
          },
          "status": {
            "type": "string",
            "description": "Lifecycle status. WAITING_FOR_PLAYER: one player, no game. ACTIVE: two players, game in progress. CLOSED: room no longer accepts activity.",
            "enum": [
              "WAITING_FOR_PLAYER",
              "ACTIVE",
              "CLOSED"
            ],
            "example": "ACTIVE"
          }
        }
      },
      "PlayerGameSummary": {
        "type": "object",
        "properties": {
          "gameId": {
            "type": "string",
            "format": "uuid"
          },
          "roomId": {
            "type": "string"
          },
          "opponentDisplayName": {
            "type": "string"
          },
          "selfRole": {
            "type": "string",
            "description": "Side the queried player was on.",
            "enum": [
              "WHITE",
              "BLACK"
            ],
            "example": "WHITE"
          },
          "status": {
            "type": "string",
            "description": "Terminal status of the game.",
            "enum": [
              "CHECKMATE",
              "STALEMATE",
              "DRAW",
              "ABANDONED",
              "TIMEOUT"
            ],
            "example": "CHECKMATE"
          },
          "endedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Instant the game was archived.",
            "example": "2026-05-19T10:23:11.123Z"
          },
          "moveCount": {
            "type": "integer",
            "format": "int32",
            "description": "Number of moves played in the game.",
            "example": 42
          }
        }
      },
      "MyGameSummary": {
        "type": "object",
        "properties": {
          "gameId": {
            "type": "string",
            "format": "uuid",
            "description": "Archived game id.",
            "example": "0d52a8a0-aaaa-bbbb-cccc-ddddeeee0000"
          },
          "roomId": {
            "type": "string",
            "description": "Room id the game was played in.",
            "example": "K7M3X9"
          },
          "opponentDisplayName": {
            "type": "string",
            "description": "Audit-time display name of the opponent (frozen at game time; a later user-rename does not rewrite past games).",
            "example": "Bob"
          },
          "selfSide": {
            "type": "string",
            "description": "Side the authenticated user was on.",
            "enum": [
              "WHITE",
              "BLACK"
            ],
            "example": "WHITE"
          },
          "status": {
            "type": "string",
            "description": "Terminal status of the game.",
            "enum": [
              "CHECKMATE",
              "STALEMATE",
              "DRAW",
              "ABANDONED",
              "TIMEOUT"
            ],
            "example": "CHECKMATE"
          },
          "endedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Instant the game was archived.",
            "example": "2026-05-19T10:23:11.123Z"
          },
          "moveCount": {
            "type": "integer",
            "format": "int32",
            "description": "Number of moves played in the game.",
            "example": 42
          }
        }
      },
      "MyGamesPage": {
        "type": "object",
        "description": "Spring Data Page envelope for MyGameSummary entries. Carries the page contents plus the pagination metadata the frontend uses to render navigation controls.",
        "properties": {
          "content": {
            "type": "array",
            "description": "Games on this page, newest first.",
            "items": {
              "$ref": "#/components/schemas/MyGameSummary"
            }
          },
          "totalElements": {
            "type": "integer",
            "format": "int64",
            "description": "Total number of games across all pages.",
            "example": 42
          },
          "totalPages": {
            "type": "integer",
            "format": "int32",
            "description": "Total number of pages.",
            "example": 3
          },
          "size": {
            "type": "integer",
            "format": "int32",
            "description": "Page size that was requested (or the default).",
            "example": 20
          },
          "number": {
            "type": "integer",
            "format": "int32",
            "description": "Zero-based page index.",
            "example": 0
          },
          "first": {
            "type": "boolean",
            "description": "True when this is the first page.",
            "example": true
          },
          "last": {
            "type": "boolean",
            "description": "True when this is the last page.",
            "example": false
          },
          "numberOfElements": {
            "type": "integer",
            "format": "int32",
            "description": "Number of entries on this page.",
            "example": 20
          },
          "empty": {
            "type": "boolean",
            "description": "True when this page is empty.",
            "example": false
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Application liveness status; always \"UP\" when reachable.",
            "example": "UP"
          },
          "version": {
            "type": "string",
            "description": "Application build version, derived from BuildProperties at boot time.",
            "example": "0.0.1-SNAPSHOT"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Server time at the moment the response was produced, in UTC.",
            "example": "2026-05-18T12:34:56Z"
          }
        }
      }
    }
  }
}
