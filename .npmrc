# Supply chain hygiene policy for chess-frontend.
#
# This file enforces three defensive layers against the npm supply-chain
# threat model documented in `docs/conventions.md` ("Supply chain hygiene"
# section) and `docs/architecture.md` (supply-chain decision record).
#
# Do not silence any of these settings without a recorded plan in
# `progress/current.md`. They are the policy, not a default.

# ignore-scripts:
# Disables `preinstall`, `install`, and `postinstall` lifecycle hooks for
# every dependency. This is the dominant attack vector in the recent wave
# of npm incidents (compromised maintainer accounts publishing malicious
# postinstall scripts in patch-level releases). With this flag, even if a
# poisoned version lands in the tree, no arbitrary code runs at install
# time. Packages that legitimately need a postinstall (e.g. `esbuild`
# downloading its platform binary) are re-materialised by an explicit
# `npm rebuild <pkg>` step in `init.sh` — that is the allowlist.
ignore-scripts=true

# engine-strict:
# Pairs with the `engines` field in `package.json`. Refuses to install on
# a Node/npm version outside the declared range instead of warning. Keeps
# every contributor and CI runner on the same supported floor (Node >=20,
# npm >=11.7).
engine-strict=true

# min-release-age:
# Refuses to install any package version published less than the given
# number of days ago. This catches the typical detection-and-deprecation
# window for compromised-account publications, which are usually pulled
# from the registry within a day or two once flagged. Requires npm 11.7+
# (current floor: 11.7 via `engines`). The npm CLI option is `<days>` as
# a plain Number (per `@npmcli/config` definitions); the "7d" form
# referenced in some external write-ups is not accepted by the loader.
min-release-age=7
