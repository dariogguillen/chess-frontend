# Example environment variables. Copy to `.env` for local development.
#
# Vite reads `VITE_*` keys at build time and inlines them in the bundle
# via `import.meta.env.*` — there is no runtime config server. Anything
# you set here is a build-time constant for that build.

# REST API base URL — used by `src/api/client.ts` to point the typed
# fetch client at the right backend.
# Production (GH Pages): set via the `VITE_API_BASE_URL` repo variable
# pointing at `https://chess-backend.duckdns.org`. Locally, the default
# below works against a backend booted with `./gradlew bootRun` in the
# chess-backend-java repo.
VITE_API_BASE_URL=http://localhost:8080

# Legacy WebSocket / STOMP backend URL — kept for the realtime path
# (feature-2 migration). The chess REST and chess STOMP backends are
# the same Spring Boot process today, so in most setups these two
# values point at the same host and just differ in port choice.
VITE_BACKEND_URL=http://localhost:8080
