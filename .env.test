# Vite reads this file when the build mode is `test` (the default
# `vitest` sets). The variables here are loaded into `import.meta.env`
# at test-time module evaluation, before any `vi.stubEnv` call runs.
#
# `VITE_BACKEND_URL` pins the API client's base URL to
# `http://localhost:8080` for the duration of a test run. The MSW
# handlers registered by every test file use absolute URLs against
# `TEST_API_BASE_URL` (defined in `src/test/msw-server.ts` to the same
# value), so the singleton `apiClient` in `src/api/client.ts` must
# emit absolute requests that match — otherwise jsdom resolves relative
# `/api/...` paths against `http://localhost/` and MSW never sees them.
#
# This explicit pin replaces the implicit "dev-default points at
# localhost:8080" behavior the test suite used to depend on. The dev
# default is now the empty string (same-origin, see `vite.config.ts`
# proxy and `src/utils/config.default.ts`), which is the correct
# runtime behavior in `npm run dev` but not what the tests want.
VITE_BACKEND_URL=http://localhost:8080
